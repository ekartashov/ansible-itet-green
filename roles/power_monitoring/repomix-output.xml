<file path="templates/read_cpu_amd_hwmon.sh.j2">
#!/usr/bin/env bash
# CPU power via AMD hwmon (fam15h_power / zenpower / similar)
# Strictly runtime-only: detection is done in Ansible.
# Outputs watts as a single float with 3 decimals, e.g.: 42.123
#
# Contract:
#   - On success:
#       * prints exactly one numeric value (watts) with 3 decimals
#       * exits with code 0
#   - On failure:
#       * prints nothing
#       * exits with non-zero code

set -euo pipefail
export LC_NUMERIC=C

# Ansible injects the detected hwmon directory here
AMD_HWMON_DIR="{{ power_monitoring_amd_cpu_hwmon_dir | default('') }}"

# Sanity check
if [ -z "$AMD_HWMON_DIR" ] || [ ! -d "$AMD_HWMON_DIR" ]; then
  exit 1
fi

total_uW=0
found_any=0

# Sum all power*_input values (in microwatts)
for f in "$AMD_HWMON_DIR"/power*_input; do
  [ -r "$f" ] || continue

  IFS= read -r value < "$f" || value=''

  # Ensure it's an integer
  case "$value" in
    ''|*[!0-9]*)
      continue
      ;;
  esac

  total_uW=$(( total_uW + value ))
  found_any=1
done

# If we found nothing or total is non-positive → treat as failure
if [ "$found_any" -eq 0 ] || [ "$total_uW" -le 0 ]; then
  exit 1
fi

# Convert µW -> W with 3 decimals:
#   W = total_uW / 1_000_000
#   milli = (total_uW % 1_000_000) / 1_000
watts=$(( total_uW / 1000000 ))
micro=$(( total_uW % 1000000 ))
milli=$(( micro / 1000 ))

# Print as X.YYY
printf '%d.%03d\n' "$watts" "$milli"
exit 0
</file>

<file path="templates/read_cpu_rapl_power.sh.j2">
#!/usr/bin/env bash
# read_cpu_rapl_power.sh - auto-generated by Ansible
#
# Usage:
#   read_cpu_rapl_power.sh <package_index>
#
# Contract:
#   - On success:
#       * prints to stdout one numeric value (watts) with 3 decimals
#       * exits with code 0
#   - On failure:
#       * exits with code 1 (and prints nothing)

set -eu

# Force C numeric locale so decimal separator is '.'
export LC_NUMERIC=C

# Sampling delay in seconds (float OK; used only in sleep + awk)
SAMPLE_DELAY="0.1"

# List of energy_uj files for each detected CPU package.
# Order matches detection order in Ansible.
RAPL_ENERGY_FILES=(
{% for path in power_monitoring_cpu_rapl_energy_files %}
"{{ path }}"
{% endfor %}
)

# --- Argument handling --------------------------------------------------------

if [ "$#" -ne 1 ]; then
  exit 1
fi

pkg_index="$1"

# pkg_index must be a non-negative integer
case "$pkg_index" in
  ''|*[!0-9]*)
    exit 1
    ;;
esac

# Bounds check
num_pkgs={{ power_monitoring_cpu_rapl_energy_files | length }}

if [ "$num_pkgs" -eq 0 ]; then
  # Script shouldn't have been deployed in this case
  exit 1
fi

max_index=$((num_pkgs - 1))
if [ "$pkg_index" -lt 0 ] || [ "$pkg_index" -gt "$max_index" ]; then
  exit 1
fi

ENERGY_FILE="${RAPL_ENERGY_FILES[$pkg_index]}"

if [ ! -r "$ENERGY_FILE" ]; then
  exit 1
fi

# --- Helpers -----------------------------------------------------------------

read_energy() {
  # Read microjoules from ENERGY_FILE, ensure it's a non-empty integer
  local v
  if ! v=$(cat "$ENERGY_FILE" 2>/dev/null); then
    return 1
  fi
  case "$v" in
    ''|*[!0-9]*)
      return 1
      ;;
  esac
  printf '%s\n' "$v"
}

# --- Sampling ----------------------------------------------------------------

E1=$(read_energy) || exit 1
sleep "$SAMPLE_DELAY"
E2=$(read_energy) || exit 1

# Sanity checks
if [ -z "$E1" ] || [ -z "$E2" ]; then
  exit 1
fi

# They are already integers; this check is defensive
if ! [ "$E1" -eq "$E1" ] 2>/dev/null; then
  exit 1
fi
if ! [ "$E2" -eq "$E2" ] 2>/dev/null; then
  exit 1
fi

# Delta in microjoules
if [ "$E2" -le "$E1" ]; then
  # Either no energy used or counter wrapped; for now treat as failure
  exit 1
fi

DELTA_UJ=$((E2 - E1))

# --- Power computation -------------------------------------------------------
# RAPL energy units:
#   energy_uj is in microjoules (μJ).
# Convert to joules: J = μJ / 1e6
# Power:
#   P [W] = J / seconds = ΔE / (1e6 * Δt)

power=$(
  awk -v d="$DELTA_UJ" -v dt="$SAMPLE_DELAY" '
    BEGIN {
      if (dt <= 0) exit 1;
      if (d < 0)   exit 1;

      # d is microjoules
      watt = d / (1000000.0 * dt);

      if (watt < 0) exit 1;

      # Up to 3 decimal places of precision
      printf "%.3f\n", watt;
    }
  ' 2>/dev/null
) || exit 1

# Final safety: non-empty and looks numeric
if [ -z "$power" ]; then
  exit 1
fi

case "$power" in
  ''|*[^0-9.]*)
    exit 1
    ;;
esac

printf '%s\n' "$power"
exit 0
</file>

<file path="templates/read_gpu_amd_power.sh.j2">
#!/usr/bin/env bash

# AMD GPU Power Monitoring Script
# This script reads instantaneous GPU power from AMD GPUs
# It outputs exactly one numeric value in watts on success

# Check if rocm-smi is available
if command -v rocm-smi >/dev/null 2>&1; then
    # Try to get power using rocm-smi
    POWER_OUTPUT=$(rocm-smi --showpower --json 2>/dev/null | grep -o '"power": [0-9]*' | cut -d' ' -f2 2>/dev/null)
    
    if [ -n "$POWER_OUTPUT" ]; then
        # rocm-smi outputs in watts, so we can directly echo it
        echo "$POWER_OUTPUT"
        exit 0
    fi
fi

# Fallback: Check sysfs for hwmon interfaces
# Look for power input files in hwmon directories
for hwmon_dir in /sys/class/drm/card*/device/hwmon/hwmon*/; do
    if [ -f "$hwmon_dir/power1_input" ]; then
        POWER_VALUE=$(cat "$hwmon_dir/power1_input" 2>/dev/null)
        if [ -n "$POWER_VALUE" ] && [ "$POWER_VALUE" != "0" ]; then
            # Check if value is in microwatts (common for hwmon)
            # If value is > 1000000, assume it's in microwatts and convert to watts
            if [ "$POWER_VALUE" -gt 1000000 ]; then
                # Convert from microwatts to watts
                watts=$((POWER_VALUE / 1000000))
            else
                # Assume already in watts
                watts="$POWER_VALUE"
            fi
            
            echo "$watts"
            exit 0
        fi
    fi
done

# If no AMD GPU power found, exit with error
exit 1
</file>

<file path="templates/read_gpu_nvidia_power.sh.j2">
#!/usr/bin/env bash

# NVIDIA GPU Power Monitoring Script
# This script reads instantaneous GPU power from NVIDIA GPUs
# It outputs exactly one numeric value in watts on success

# Check if nvidia-smi is available
if ! command -v nvidia-smi >/dev/null 2>&1; then
    exit 1
fi

# Get GPU power draw using nvidia-smi
POWER_OUTPUT=$(nvidia-smi --query-gpu=power.draw --format=csv,noheader,nounits 2>/dev/null)

# Check if we got a valid output
if [ -z "$POWER_OUTPUT" ] || [ "$POWER_OUTPUT" = "0" ]; then
    exit 1
fi

# Output the power value (it should already be in watts)
echo "$POWER_OUTPUT"
exit 0
</file>

