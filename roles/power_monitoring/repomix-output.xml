<file path="tasks/detect_gpu.yml">
---
# Task file for detecting GPU capabilities

- name: Check for NVIDIA GPU support
  command: which nvidia-smi
  register: nvidia_smi_result
  ignore_errors: true

- name: Check for AMD GPU support (rocm-smi)
  command: which rocm-smi
  register: rocm_smi_result
  ignore_errors: true

- name: Set fact for NVIDIA GPU availability
  set_fact:
    power_monitoring_has_nvidia_gpu: "{{ nvidia_smi_result.rc == 0 }}"

- name: Set fact for AMD GPU availability
  set_fact:
    power_monitoring_has_amd_gpu: "{{ rocm_smi_result.rc == 0 }}"

- name: Display GPU detection results
  debug:
    msg: "NVIDIA GPU: {{ power_monitoring_has_nvidia_gpu }}, AMD GPU: {{ power_monitoring_has_amd_gpu }}"
</file>

<file path="tasks/detect_ram_rapl.yml">
---
# Task file for detecting RAM/DRAM RAPL domains per CPU package

- name: Reset RAM RAPL facts
  ansible.builtin.set_fact:
    power_monitoring_ram_rapl_energy_files: []
    power_monitoring_has_ram_rapl: false

- name: Detect DRAM/memory RAPL domains per package
  ansible.builtin.shell:
    cmd: |
      set -eu

      # CPU package energy files from Ansible (same order as detect_rapl.yml)
      cpu_pkg_energy_files="{{ power_monitoring_cpu_rapl_energy_files | join(' ') }}"

      # If nothing was detected, bail out early
      if [ -z "$cpu_pkg_energy_files" ]; then
        exit 0
      fi

      for cpu_energy in $cpu_pkg_energy_files; do
        # cpu_energy is e.g. /sys/class/powercap/intel-rapl:0/energy_uj
        pkg_dir="$(dirname "$cpu_energy")"  # -> /sys/class/powercap/intel-rapl:0

        dram_path=""

        # Look for subdomains like intel-rapl:0:1 with name "dram" / "memory" / "ram"
        for sub in "${pkg_dir}":*; do
          [ -d "$sub" ] || continue

          name_file="$sub/name"
          energy_file="$sub/energy_uj"

          if [ ! -f "$name_file" ] || [ ! -f "$energy_file" ]; then
            continue
          fi

          sub_name="$(cat "$name_file" 2>/dev/null || echo "")"

          # Case-insensitive match for dram/memory/ram
          case "${sub_name,,}" in
            *dram*|*memory*|*ram*)
              dram_path="$energy_file"
              break
              ;;
          esac
        done

        # Even if we don't find a DRAM domain for this package, print "-"
        if [ -n "$dram_path" ]; then
          printf '%s\n' "$dram_path"
        else
          printf '%s\n' "-\n"
        fi
      done
  args:
    executable: /bin/bash
  register: ram_rapl_paths
  changed_when: false
  failed_when: false
  when:
    - power_monitoring_has_intel_rapl | default(false)
    - power_monitoring_cpu_rapl_energy_files | default([]) | length > 0

- name: Set RAM RAPL facts
  ansible.builtin.set_fact:
    power_monitoring_ram_rapl_energy_files: "{{ ram_rapl_paths.stdout_lines | default([]) }}"
    power_monitoring_has_ram_rapl: >-
      {{ (ram_rapl_paths.stdout_lines | default([]) | reject('equalto', '-') | list | length) > 0 }}
  when:
    - ram_rapl_paths is defined

- name: Display RAM RAPL detection results
  ansible.builtin.debug:
    msg: >-
      RAM RAPL: {{ power_monitoring_has_ram_rapl }}
      ({{ power_monitoring_ram_rapl_energy_files | reject('equalto', '-') | list | length }} DRAM domain(s) detected,
       raw entries={{ power_monitoring_ram_rapl_energy_files }})
  when:
    - ram_rapl_paths is defined
</file>

<file path="tasks/detect_rapl.yml">
---
# Task file for detecting RAPL capabilities

- name: Check for Intel RAPL root directory
  ansible.builtin.stat:
    path: /sys/class/powercap/intel-rapl
  register: intel_rapl_stat

- name: Detect Intel RAPL package energy_uj files
  when: intel_rapl_stat.stat.exists | default(false)
  ansible.builtin.shell: |
    set -eu

    # If there are no intel-rapl:* entries, we just print nothing
    shopt -s nullglob

    for d in /sys/class/powercap/intel-rapl:*; do
      [ -d "$d" ] || continue

      name_file="$d/name"
      energy_file="$d/energy_uj"

      # Require both name and energy_uj
      if [ ! -f "$name_file" ] || [ ! -f "$energy_file" ]; then
        continue
      fi

      # Only top-level "package-*" domains (not dram/core subdomains)
      if grep -q '^package-' "$name_file"; then
        printf '%s\n' "$energy_file"
      fi
    done
  args:
    executable: /bin/bash
  register: intel_rapl_energy_files
  changed_when: false
  failed_when: false

- name: Set facts for Intel RAPL availability
  ansible.builtin.set_fact:
    power_monitoring_cpu_rapl_energy_files: "{{ intel_rapl_energy_files.stdout_lines | default([]) }}"
    power_monitoring_has_intel_rapl: "{{ (intel_rapl_energy_files.stdout_lines | default([])) | length > 0 }}"

- name: Display RAPL detection results
  ansible.builtin.debug:
    msg: >-
      RAPL: {{ power_monitoring_has_intel_rapl }}
      ({{ power_monitoring_cpu_rapl_energy_files | length }} package domain(s) detected)

- name: Detect AMD CPU hwmon (fam15h_power / zenpower) as fallback
  ansible.builtin.shell:
    cmd: |
      set -eu
      shopt -s nullglob

      for d in /sys/class/hwmon/hwmon*; do
        [ -d "$d" ] || continue

        name_file="$d/name"
        if [ ! -f "$name_file" ]; then
          continue
        fi

        name=$(cat "$name_file" 2>/dev/null || echo "")

        case "$name" in
          fam15h_power|zenpower|zenpower3|amd_energy)
            printf '%s\n' "$d"
            exit 0
            ;;
        esac
      done

      # Nothing found → non-zero rc
      exit 1
  args:
    executable: /bin/bash
  register: amd_cpu_hwmon_detect
  changed_when: false
  failed_when: false
  when:
    - power_monitoring_enable_cpu | default('auto') != 'false'
    - not power_monitoring_has_intel_rapl | default(false)

- name: Set facts for AMD CPU hwmon availability
  ansible.builtin.set_fact:
    power_monitoring_has_amd_cpu_hwmon: "{{ amd_cpu_hwmon_detect.rc == 0 }}"
    power_monitoring_amd_cpu_hwmon_dir: "{{ amd_cpu_hwmon_detect.stdout if amd_cpu_hwmon_detect.rc == 0 else '' }}"
  when:
    - power_monitoring_enable_cpu | default('auto') != 'false'
    - not power_monitoring_has_intel_rapl | default(false)
</file>

