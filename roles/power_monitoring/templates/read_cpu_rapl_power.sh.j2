#!/usr/bin/env bash
# read_cpu_rapl_power.sh - auto-generated by Ansible
#
# Usage:
#   read_cpu_rapl_power.sh <package_index>
#
# Contract:
#   - On success:
#       * prints to stdout one numeric value (watts) with 3 decimals
#       * exits with code 0
#   - On failure:
#       * exits with code 1

set -eu

# Force C numeric locale so decimal separator is '.'
export LC_NUMERIC=C

# Sampling delay in seconds (float OK; used only in sleep + awk)
SAMPLE_DELAY="0.1"

# List of energy_uj files for each detected CPU package.
# Order matches detection order in Ansible.
RAPL_ENERGY_FILES=(
{% for path in power_monitoring_cpu_rapl_energy_files %}
"{{ path }}"
{% endfor %}
)

# --- Argument handling --------------------------------------------------------

if [ "$#" -ne 1 ]; then
  exit 1
fi

pkg_index="$1"

# pkg_index must be a non-negative integer
case "$pkg_index" in
  ''|*[!0-9]*)
    exit 1
    ;;
esac

# Bounds check
num_pkgs=${#RAPL_ENERGY_FILES[@]}
if [ "$num_pkgs" -eq 0 ]; then
  # Script shouldn't have been deployed in this case
  exit 1
fi

max_index=$((num_pkgs - 1))
if [ "$pkg_index" -lt 0 ] || [ "$pkg_index" -gt "$max_index" ]; then
  exit 1
fi

ENERGY_FILE="${RAPL_ENERGY_FILES[$pkg_index]}"

if [ ! -r "$ENERGY_FILE" ]; then
  exit 1
fi

# --- Helpers -----------------------------------------------------------------

read_energy() {
  # Read microjoules from ENERGY_FILE, ensure it's a non-empty integer
  local v
  if ! v=$(cat "$ENERGY_FILE" 2>/dev/null); then
    return 1
  fi
  case "$v" in
    ''|*[!0-9]*)
      return 1
      ;;
  esac
  printf '%s\n' "$v"
}

# --- Sampling ----------------------------------------------------------------

E1=$(read_energy) || exit 1
sleep "$SAMPLE_DELAY"
E2=$(read_energy) || exit 1

# Sanity checks
if [ -z "$E1" ] || [ -z "$E2" ]; then
  exit 1
fi

# They are already integers; this check is defensive
if ! [ "$E1" -eq "$E1" ] 2>/dev/null; then
  exit 1
fi
if ! [ "$E2" -eq "$E2" ] 2>/dev/null; then
  exit 1
fi

# Delta in microjoules
if [ "$E2" -le "$E1" ]; then
  # Either no energy used or counter wrapped; for now treat as failure
  exit 1
fi

DELTA_UJ=$((E2 - E1))

# --- Power computation -------------------------------------------------------
# RAPL energy units:
#   energy_uj is in microjoules (μJ).
# Convert to joules: J = μJ / 1e6
# Power:
#   P [W] = J / seconds = ΔE / (1e6 * Δt)

power=$(
  awk -v d="$DELTA_UJ" -v dt="$SAMPLE_DELAY" '
    BEGIN {
      if (dt <= 0) exit 1;
      if (d < 0)   exit 1;

      # d is microjoules
      watt = d / (1000000.0 * dt);

      if (watt < 0) exit 1;

      # Up to 3 decimal places of precision
      printf "%.3f\n", watt;
    }
  ' 2>/dev/null
) || exit 1

# Final safety: non-empty and looks numeric
if [ -z "$power" ]; then
  exit 1
fi

case "$power" in
  ''|*[^0-9.]*)
    exit 1
    ;;
esac

printf '%s\n' "$power"
exit 0
