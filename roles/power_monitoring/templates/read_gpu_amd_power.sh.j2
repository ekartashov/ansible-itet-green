#!/usr/bin/env bash

# read_gpu_amd_power.sh - per-GPU AMD power reader via rocm-smi
#
# Usage:
#   read_gpu_amd_power.sh <gpu_index>
#
# Contract:
#   - On success:
#       * prints exactly one numeric value (watts) with up to 3 decimals
#       * exits with code 0
#   - On failure:
#       * prints nothing
#       * exits with non-zero code

set -euo pipefail
export LC_NUMERIC=C

# rocm-smi must exist
if ! command -v rocm-smi >/dev/null 2>&1; then
  exit 1
fi

# --- Argument handling --------------------------------------------------------

if [ "$#" -ne 1 ]; then
  exit 1
fi

gpu_index="$1"

case "$gpu_index" in
  ''|*[!0-9]*)
    exit 1
    ;;
esac

# --- Parse rocm-smi table -----------------------------------------------------
# We rely on the concise table output, e.g.:
# GPU  Temp (DieEdge)  AvgPwr  SCLK  MCLK ...
# 0    37.0c           75.0W   ...
# or
# 0    37.0c           N/A     ...
#
# Column 1: GPU index
# Column 3: AvgPwr (e.g. "75.0W" or "N/A")

power=$(
  rocm-smi 2>/dev/null | awk -v idx="$gpu_index" '
    $1 == idx {
      pwr = $3
      gsub(/W$/, "", pwr)

      # Ignore unsupported / N/A values
      if (pwr == "N/A") {
        next
      }

      if (pwr ~ /^[0-9.]+$/) {
        printf "%.3f\n", pwr
        exit 0
      }
    }
    END { exit 1 }
  ' 2>/dev/null || true
)

# If we could not extract a clean numeric power value -> treat as unsupported
if [ -z "${power:-}" ]; then
  exit 1
fi

case "$power" in
  ''|*[^0-9.]*)
    exit 1
    ;;
esac

printf '%s\n' "$power"
exit 0
