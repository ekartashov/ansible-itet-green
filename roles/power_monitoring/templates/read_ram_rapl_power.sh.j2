#!/usr/bin/env bash
# read_ram_rapl_power.sh - auto-generated by Ansible (per-package RAM RAPL)
#
# Usage:
#   read_ram_rapl_power.sh <package_index>
#
# Contract:
#   - On success:
#       * prints exactly one numeric value (watts) with up to 3 decimals
#       * exits with code 0
#   - On failure:
#       * prints nothing
#       * exits with non-zero code

set -eu

# Force C numeric locale so decimal separator is '.'
export LC_NUMERIC=C

SAMPLE_DELAY="0.1"

# List of DRAM/memory RAPL energy_uj files, aligned with CPU packages.
# If a package has no DRAM RAPL domain, its entry will be "-" (string).
RAPL_ENERGY_FILES=(
{% for path in power_monitoring_ram_rapl_energy_files %}
"{{ path }}"
{% endfor %}
)

# --- Argument handling --------------------------------------------------------

if [ "$#" -ne 1 ]; then
  exit 1
fi

pkg_index="$1"

case "$pkg_index" in
  ''|*[!0-9]*)
    exit 1
    ;;
esac

num_pkgs={{ power_monitoring_ram_rapl_energy_files | length }}

if [ "$num_pkgs" -eq 0 ]; then
  exit 1
fi

max_index=$((num_pkgs - 1))
if [ "$pkg_index" -lt 0 ] || [ "$pkg_index" -gt "$max_index" ]; then
  exit 1
fi

ENERGY_FILE="${RAPL_ENERGY_FILES[$pkg_index]}"

# If no DRAM RAPL domain for this package, treat as "not supported"
if [ "$ENERGY_FILE" = "-" ] || [ ! -r "$ENERGY_FILE" ]; then
  exit 1
fi

read_energy() {
  local v
  if ! v=$(cat "$ENERGY_FILE" 2>/dev/null); then
    return 1
  fi
  case "$v" in
    ''|*[!0-9]*)
      return 1
      ;;
  esac
  printf '%s\n' "$v"
}

# --- Sampling ----------------------------------------------------------------

E1=$(read_energy) || exit 1
sleep "$SAMPLE_DELAY"
E2=$(read_energy) || exit 1

if [ -z "$E1" ] || [ -z "$E2" ]; then
  exit 1
fi

if ! [ "$E1" -eq "$E1" ] 2>/dev/null; then
  exit 1
fi
if ! [ "$E2" -eq "$E2" ] 2>/dev/null; then
  exit 1
fi

if [ "$E2" -le "$E1" ]; then
  exit 1
fi

DELTA_UJ=$((E2 - E1))

# --- Power computation -------------------------------------------------------

power=$(
  awk -v d="$DELTA_UJ" -v dt="$SAMPLE_DELAY" '
    BEGIN {
      if (dt <= 0) exit 1;
      if (d < 0)   exit 1;

      watt = d / (1000000.0 * dt);

      if (watt < 0) exit 1;

      printf "%.3f\n", watt;
    }
  ' 2>/dev/null
) || exit 1

if [ -z "$power" ]; then
  exit 1
fi

case "$power" in
  ''|*[^0-9.]*)
    exit 1
    ;;
esac

printf '%s\n' "$power"
exit 0
